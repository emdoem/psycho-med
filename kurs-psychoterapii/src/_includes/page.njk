---
layout: base.njk
---
{% set section = nav.sectionFor[page.url] %}
<div class="content">
  <div class="page-head">
    {% if section %}<p class="mono" id="page-section-label">{{ section.label }}</p>{% endif %}
    <h1 id="page-title">{{ title }}</h1>
  </div>

  {% if section and section.items.length %}
  {# Section nav sits after the h1 on phones (short list, wayfinding before long prose) and beside the prose from 52rem. #}
  <div class="page-body page-body--aside">
    <aside class="secnav">
      <nav aria-labelledby="page-section-label page-title">
        <ul class="secnav__list">
          {% for item in section.items %}
          <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}{% if item.external %} rel="noopener"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </aside>
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
  {% else %}
  <div class="page-body">
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
  {% endif %}
</div>
